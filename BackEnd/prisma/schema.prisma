// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlaceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Place {
  id           String       @id @default(uuid())
  name         String
  lat          Float
  lng          Float
  abbr         String?
  type         String?
  description  String? @db.Text
  favoredBy    Favorite[]
  status       PlaceStatus  @default(APPROVED)
  createdById  String
  createdBy    User?        @relation("PlacesCreated", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?        @relation("PlacesApproved", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  @@index([status])
  @@index([createdById])
  @@index([approvedById]) 
  photos       PlacePhoto[]
  reviews Review[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Int       // 1–5 stars
  comment   String
  createdAt DateTime  @default(now())

  // Relations
  userId    String
  placeId   String
  user      User      @relation(fields: [userId], references: [id])
  place     Place     @relation(fields: [placeId], references: [id])
}


model PlacePhoto {
  id           String      @id @default(uuid())
  placeId      String
  place        Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?     // Cloudinary public_id for deletions or transformations
  caption      String?     
  isPrimary    Boolean     @default(false)
  order        Int?        
  status       PhotoStatus @default(APPROVED)
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id String @id @default(uuid())
  name String 
  email String @unique
  passwordHash String
  favorites  Favorite[]
  role   Role  @default(USER) 
  placesCreated   Place[]        @relation("PlacesCreated")
  placesApproved Place[] @relation("PlacesApproved")

  PlacePhoto PlacePhoto[]

  reviews Review[]
}

model Favorite {
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place  Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])   
  @@index([userId])
  @@index([placeId])
}

